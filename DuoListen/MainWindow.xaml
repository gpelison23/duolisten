<ui:FluentWindow x:Class="DuoListen.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
                 Title="DuoListen"
                 Width="580"
                 SizeToContent="Height"
                 ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <Style x:Key="SectionHeader" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="BodyStrong" />
            <Setter Property="Margin" Value="2,22,0,8" />
        </Style>
        <Style x:Key="CardTitle" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="Body" />
        </Style>
        <Style x:Key="CardDesc" TargetType="ui:TextBlock">
            <Setter Property="FontTypography" Value="Caption" />
            <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CardCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Width" Value="240" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="DuoListen"
                     ShowMaximize="False" CanMaximize="False">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Headphones24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Ícone na bandeja do Windows -->
        <tray:NotifyIcon x:Name="Tray" Grid.Row="0"
                         FocusOnLeftClick="True" MenuOnRightClick="True"
                         TooltipText="DuoListen">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <ui:MenuItem x:Name="MiToggle" Click="MiToggle_Click">
                        <ui:MenuItem.Icon><ui:SymbolIcon x:Name="MiToggleIcon" Symbol="Play24" /></ui:MenuItem.Icon>
                    </ui:MenuItem>
                    <ui:MenuItem x:Name="MiOpen" Click="MiOpen_Click">
                        <ui:MenuItem.Icon><ui:SymbolIcon Symbol="Window24" /></ui:MenuItem.Icon>
                    </ui:MenuItem>
                    <Separator />
                    <ui:MenuItem x:Name="MiExit" Click="MiExit_Click">
                        <ui:MenuItem.Icon><ui:SymbolIcon Symbol="Dismiss24" /></ui:MenuItem.Icon>
                    </ui:MenuItem>
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Grid.Row="1" Margin="20,0,20,20">

            <!-- Liga/desliga principal -->
            <ui:CardControl Margin="0,4,0,0">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="HeadphonesSoundWave24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock x:Name="MainTitle" Style="{StaticResource CardTitle}" />
                        <ui:TextBlock x:Name="MainDesc" Style="{StaticResource CardDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="PlaySwitch" Click="PlaySwitch_Click" />
            </ui:CardControl>

            <ui:InfoBar x:Name="ErrorBar" Margin="0,8,0,0" Severity="Error" IsClosable="True" IsOpen="False" />

            <!-- Origem do som -->
            <Grid>
                <ui:TextBlock x:Name="HdrSource" Style="{StaticResource SectionHeader}" />
                <ui:Button x:Name="RefreshButton" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="0,0,0,4" Appearance="Transparent" Click="Refresh_Click">
                    <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:Button.Icon>
                </ui:Button>
            </Grid>
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Speaker224" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock x:Name="SourceTitle" Style="{StaticResource CardTitle}" />
                        <ui:TextBlock x:Name="SourceDesc" Style="{StaticResource CardDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="SourceCombo" Style="{StaticResource CardCombo}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,4,0,0">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="SpeakerMute24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock x:Name="MuteTitle" Style="{StaticResource CardTitle}" />
                        <ui:TextBlock x:Name="MuteDesc" Style="{StaticResource CardDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="MuteSwitch" Click="MuteSwitch_Click" />
            </ui:CardControl>

            <!-- Fones -->
            <ui:TextBlock x:Name="HdrPhones" Style="{StaticResource SectionHeader}" />

            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Headphones24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <ui:TextBlock x:Name="Phone1Title" Style="{StaticResource CardTitle}" />
                </ui:CardControl.Header>
                <ComboBox x:Name="Out1Combo" Style="{StaticResource CardCombo}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,4,0,0">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Speaker224" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <ui:TextBlock x:Name="Vol1Title" Style="{StaticResource CardTitle}" />
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="Vol1" Width="200" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                    <ui:TextBlock x:Name="Vol1Pct" Width="40" Margin="12,0,0,0" TextAlignment="Right" VerticalAlignment="Center" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Margin="0,12,0,0">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Headphones24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <ui:TextBlock x:Name="Phone2Title" Style="{StaticResource CardTitle}" />
                </ui:CardControl.Header>
                <ComboBox x:Name="Out2Combo" Style="{StaticResource CardCombo}" />
            </ui:CardControl>
            <ui:CardControl Margin="0,4,0,0">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Speaker224" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <ui:TextBlock x:Name="Vol2Title" Style="{StaticResource CardTitle}" />
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="Vol2" Width="200" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                            IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                    <ui:TextBlock x:Name="Vol2Pct" Width="40" Margin="12,0,0,0" TextAlignment="Right" VerticalAlignment="Center" />
                </StackPanel>
            </ui:CardControl>

            <!-- Sincronia (avançado) -->
            <ui:CardExpander Margin="0,12,0,0">
                <ui:CardExpander.Icon><ui:SymbolIcon Symbol="Timer24" /></ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <StackPanel>
                        <ui:TextBlock x:Name="SyncTitle" Style="{StaticResource CardTitle}" />
                        <ui:TextBlock x:Name="SyncDesc" Style="{StaticResource CardDesc}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <Grid Margin="40,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:TextBlock x:Name="Delay1Label" Grid.Row="0" VerticalAlignment="Center" />
                    <ui:NumberBox x:Name="Delay1" Grid.Row="0" Grid.Column="1" Width="150"
                                  Minimum="0" Maximum="1000" SmallChange="10" LargeChange="100" MaxDecimalPlaces="0"
                                  SpinButtonPlacementMode="Inline" ClearButtonEnabled="False" />
                    <ui:TextBlock x:Name="Delay2Label" Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center" />
                    <ui:NumberBox x:Name="Delay2" Grid.Row="1" Grid.Column="1" Width="150" Margin="0,8,0,0"
                                  Minimum="0" Maximum="1000" SmallChange="10" LargeChange="100" MaxDecimalPlaces="0"
                                  SpinButtonPlacementMode="Inline" ClearButtonEnabled="False" />
                </Grid>
            </ui:CardExpander>

            <!-- Geral -->
            <ui:TextBlock x:Name="HdrGeneral" Style="{StaticResource SectionHeader}" />
            <ui:CardControl>
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="LocalLanguage24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <ui:TextBlock x:Name="LangTitle" Style="{StaticResource CardTitle}" />
                </ui:CardControl.Header>
                <ComboBox x:Name="LangCombo" Style="{StaticResource CardCombo}">
                    <ComboBoxItem Content="Português (Brasil)" />
                    <ComboBoxItem Content="English" />
                </ComboBox>
            </ui:CardControl>
            <ui:CardControl Margin="0,4,0,0">
                <ui:CardControl.Icon><ui:SymbolIcon Symbol="Delete24" /></ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock x:Name="UninstallTitle" Style="{StaticResource CardTitle}" />
                        <ui:TextBlock x:Name="UninstallDesc" Style="{StaticResource CardDesc}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button x:Name="UninstallButton" Appearance="Danger" Click="Uninstall_Click" />
            </ui:CardControl>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
